{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Vision Support 設定檔 - 複製為 config.json 後按需修改",

  "models": [
    {
      "name": "GPT-4o Vision",
      "provider": "openai",
      "model": "gpt-4o",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "apiKey": "",
      "timeout": 30000
    },
    {
      "name": "Gemini Flash",
      "provider": "google",
      "model": "gemini-2.0-flash",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "apiKeyEnv": "GEMINI_API_KEY",
      "apiKey": "",
      "timeout": 30000
    },
    {
      "name": "Qwen-VL-Max",
      "provider": "openai",
      "model": "qwen-vl-max",
      "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "apiKeyEnv": "DASHSCOPE_API_KEY",
      "apiKey": "",
      "timeout": 30000
    },
    {
      "name": "GLM-4V-Plus",
      "provider": "openai",
      "model": "glm-4v-plus",
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "apiKeyEnv": "GLM_API_KEY",
      "apiKey": "",
      "timeout": 30000
    }
  ],

  "defaultPrompt": "Please describe this image in detail. If it shows a UI/web page, describe the layout, elements, colors, and any visible issues, errors, or misalignments. If it shows code output or terminal, describe the content and any error messages.",

  "proxy": {
    "_comment": "代理設定。disable 為 true 時完全停用代理（含環境變數，fetch 一律直連）；為 false/預設時依 環境變數 > urls > Windows 系統代理 > 探測常見連接埠 自動偵測。urls 非空時優先使用，不通則回退到自動偵測。",
    "disable": false,
    "urls": []
  },

  "maxImageSize": 20971520,
  "supportedFormats": ["jpg", "jpeg", "png", "gif", "webp", "bmp", "svg"]
}
